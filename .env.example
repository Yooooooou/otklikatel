# Скопируйте в .env и заполните. Файл .env не коммитится.
HH_CLIENT_ID=
HH_CLIENT_SECRET=
# Обновляются автоматически после `python main.py auth`
HH_ACCESS_TOKEN=
HH_REFRESH_TOKEN=
ANTHROPIC_API_KEY=
# Необязательно: redirect_uri, зарегистрированный в приложении на dev.hh.ru
HH_REDIRECT_URI=
# HH требует осмысленный User-Agent
HH_USER_AGENT=hh-auto-apply/1.0 (you@example.com)
